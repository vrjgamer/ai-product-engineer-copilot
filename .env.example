# Model provider (lib/models/provider.ts). The deployed demo runs Google —
# see ARCHITECTURE.md §2 — because that's the key available at no cost;
# ANTHROPIC_API_KEY + claude-haiku-4-5 is the other supported pairing.
# Whatever you set here needs a matching row in lib/tracing/pricing.ts, or
# the run trace reports $0 rather than a real cost.
MODEL_PROVIDER=google
MODEL_ID=gemini-3.6-flash

# Only the API key matching MODEL_PROVIDER is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Eval judge (lib/eval/judgeModel.ts, TDD 0011). Optional — each falls back
# to MODEL_PROVIDER/MODEL_ID above, and only `npm run eval` reads them; no
# visitor run is judged. Point them at a stronger model than the graph's to
# grade with something other than the model being graded; the control
# documents in eval/golden/controls.json will tell you whether the judge you
# picked is calibrated enough to trust. Reuses the API key of whichever
# provider you name.
JUDGE_PROVIDER=
JUDGE_MODEL_ID=

# Embeddings provider (mcp/docs-store/embeddings.ts) — separate from
# MODEL_PROVIDER above, since Anthropic has no embeddings API. Defaults to
# google. Only the API key matching EMBEDDING_PROVIDER is required (reuses
# OPENAI_API_KEY/GOOGLE_GENERATIVE_AI_API_KEY above). Don't change this on an
# already-indexed corpus without re-running scripts/index-docs.ts —
# embeddings across providers aren't comparable.
EMBEDDING_PROVIDER=google

# Neon Postgres connection string (lib/db/client.ts). Required for
# migrations, LangGraph checkpointing, persistent memory, and the docs-store/
# analytics MCP servers' tables (TDD 0004).
DATABASE_URL=

# GitHub API (mcp/analytics). GITHUB_TOKEN is optional but recommended —
# unauthenticated requests hit a much lower rate limit. GITHUB_DEMO_REPO
# (owner/repo) defaults to this project's own repo.
GITHUB_TOKEN=
GITHUB_DEMO_REPO=vrjgamer/ai-product-engineer-copilot

# IP-based rate limiting (lib/rate-limit/, TDD 0006). RATE_LIMIT_IP_SALT is
# required — visitor IPs are hashed with it before ever being written to the
# rate_limits table, and are never stored raw. RATE_LIMIT_MAX_RUNS_PER_HOUR
# defaults to 5 if unset.
RATE_LIMIT_IP_SALT=
RATE_LIMIT_MAX_RUNS_PER_HOUR=5
