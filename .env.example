# Model provider (lib/models/provider.ts)
MODEL_PROVIDER=anthropic
MODEL_ID=claude-haiku-4-5

# Only the API key matching MODEL_PROVIDER is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Embeddings provider (mcp/docs-store/embeddings.ts) — separate from
# MODEL_PROVIDER above, since Anthropic has no embeddings API. Defaults to
# google. Only the API key matching EMBEDDING_PROVIDER is required (reuses
# OPENAI_API_KEY/GOOGLE_GENERATIVE_AI_API_KEY above). Don't change this on an
# already-indexed corpus without re-running scripts/index-docs.ts —
# embeddings across providers aren't comparable.
EMBEDDING_PROVIDER=google

# Neon Postgres connection string (lib/db/client.ts). Required for
# migrations, LangGraph checkpointing, persistent memory, and the docs-store/
# analytics MCP servers' tables (TDD 0004).
DATABASE_URL=

# GitHub API (mcp/analytics). GITHUB_TOKEN is optional but recommended —
# unauthenticated requests hit a much lower rate limit. GITHUB_DEMO_REPO
# (owner/repo) defaults to this project's own repo.
GITHUB_TOKEN=
GITHUB_DEMO_REPO=vrjgamer/ai-product-engineer-copilot
