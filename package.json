{
  "name": "ai-product-engineer-copilot",
  "version": "1.0.0",
  "description": "Multi-agent graph (LangGraph) that generates PRDs, user stories, experiment designs, architecture reviews, and roadmaps.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/migrate.ts || echo 'Migration step failed — continuing build, but check logs.'; next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:e2e": "npx tsx scripts/model-roundtrip.ts && npx tsx scripts/checkpoint-roundtrip.ts && npx tsx scripts/clarification-roundtrip.ts && npx tsx scripts/mcp-roundtrip.ts",
    "eval": "npx tsx scripts/eval.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.27",
    "@ai-sdk/google": "^4.0.31",
    "@ai-sdk/openai": "^4.0.27",
    "@langchain/core": "^1.2.4",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.49",
    "next": "^16.3.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  }
}
